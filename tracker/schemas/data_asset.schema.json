{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conroyriodss.github.io/tracker/schemas/data_asset.schema.json",
  "title": "NIH Tracker data asset",
  "type": "object",
  "required": ["asset_uid", "title", "asset_type", "repository_uids", "provenance"],
  "properties": {
    "asset_uid": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "asset_type": {"type": "string", "minLength": 1},
    "identifiers": {"type": "array", "items": {"type": "object", "required": ["type", "value"], "properties": {"type": {"type": "string"}, "value": {"type": "string"}, "url": {"type": "string"}}, "additionalProperties": false}},
    "version": {"type": "string"},
    "release_date": {"type": "string"},
    "repository_uids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "access_system_uids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "creators": {"type": "array", "items": {"type": "string"}},
    "stewards": {"type": "array", "items": {"type": "string"}},
    "ror_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "nih_awards": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "nih_ics": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "subject_areas": {"type": "array", "items": {"type": "string"}},
    "populations": {"type": "array", "items": {"type": "string"}},
    "modalities": {"type": "array", "items": {"type": "string"}},
    "data_types": {"type": "array", "items": {"type": "string"}},
    "formats": {"type": "array", "items": {"type": "string"}},
    "standards": {"type": "array", "items": {"type": "string"}},
    "access_level": {"type": "string"},
    "consent_or_use_terms": {"type": "array", "items": {"type": "string"}},
    "duo_terms": {"type": "array", "items": {"type": "string"}},
    "guid_systems": {"type": "array", "items": {"type": "string"}},
    "api_or_distribution_links": {"type": "array", "items": {"type": "string"}},
    "related_publications": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "object", "required": ["source", "source_snapshot_sha256", "as_of"], "properties": {"source": {"type": "string"}, "source_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "as_of": {"type": "string"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
